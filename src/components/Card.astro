---
import { parseTitle, toNumericUrl } from '@/util';

export interface Props {
  post: {
    url: string;
    frontmatter: {
      description: string;
      date: string;
      legacySlug?: string;
      issueTitle?: string;
      numericUrl?: string;
    };
  };
}

const { post } = Astro.props;
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);

const legacySlug = post.frontmatter?.legacySlug;
const issueTitle = post.frontmatter?.issueTitle;
const link = post.frontmatter?.numericUrl ?? toNumericUrl(post.url);
const title = parseTitle(link, legacySlug, issueTitle, lang);
const { description, date } = post.frontmatter;
---

<a
  href={link}
  data-astro-prefetch
  class='article-card rounded-lg shadow-md overflow-hidden w-full card-content preload-link'
  style='transition: all 200ms ease; will-change: transform;'
>
  <div class='w-full flex justify-between items-baseline leading-tight'>
    <div
      class='text-gray-800 dark:text-gray-200 font-semibold md:text-lg text-lg overflow-hidden text-ellipsis whitespace-nowrap flex-1 mr-4 min-w-0'
    >
      {title}
    </div>
    <time class='text-grey-darker text-gray-600 dark:text-gray-300 md:text-sm text-sm flex-shrink-0' datetime={date}>
      {date}
    </time>
  </div>
  <p class='text-gray-600 dark:text-gray-300 overflow-hidden pt-2 line-clamp-2 w-full md:text-sm text-base'>
    {description}
  </p>
</a>

<style>
  .article-card {
    display: block;
    padding: 18px 20px;
  }

  @media (max-width: 640px) {
    .article-card {
      padding: 16px;
    }
  }
</style>
