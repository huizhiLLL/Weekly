---
import { parseTitle, toNumericUrl } from '@/util';

export interface Props {
  post: {
    url: string;
    frontmatter: {
      tags?: string[];
      date: string;
      legacySlug?: string;
      issueTitle?: string;
      numericUrl?: string;
    };
  };
}

const { post } = Astro.props;
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);

const legacySlug = post.frontmatter?.legacySlug;
const issueTitle = post.frontmatter?.issueTitle;
const link = post.frontmatter?.numericUrl ?? toNumericUrl(post.url);
const title = parseTitle(link, legacySlug, issueTitle, lang);
const { date } = post.frontmatter;
const tags = post.frontmatter.tags ?? [];
---

<a
  href={link}
  data-astro-prefetch
  class='article-card rounded-lg shadow-md overflow-hidden w-full card-content preload-link'
  style='transition: all 200ms ease; will-change: transform;'
>
  <div class='w-full flex justify-between items-baseline leading-tight'>
    <div
      class='text-gray-800 dark:text-gray-200 font-semibold md:text-lg text-lg overflow-hidden text-ellipsis whitespace-nowrap flex-1 mr-4 min-w-0'
    >
      {title}
    </div>
    <time class='text-grey-darker text-gray-600 dark:text-gray-300 md:text-sm text-sm flex-shrink-0' datetime={date}>
      {date}
    </time>
  </div>
  {
    tags.length > 0 && (
      <div class='article-tags' aria-label='文章标签'>
        {tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  .article-card {
    display: block;
    padding: 18px 20px;
  }

  @media (max-width: 640px) {
    .article-card {
      padding: 16px;
    }
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 12px;
  }

  .article-tags span {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 2px 9px;
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 999px;
    color: rgb(75 85 99);
    background: rgba(148, 163, 184, 0.08);
    font-size: 13px;
    line-height: 1.4;
    white-space: nowrap;
  }

  :global([data-theme='dark']) .article-tags span {
    color: rgb(209 213 219);
    border-color: rgba(148, 163, 184, 0.24);
    background: rgba(148, 163, 184, 0.1);
  }
</style>
