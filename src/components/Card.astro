---
import { parseTitle, toNumericUrl } from '@/util';

export interface Props {
  post: {
    url: string;
    frontmatter: {
      tags?: string[];
      image: string;
      description: string;
      date: string;
      legacySlug?: string;
      issueTitle?: string;
      numericUrl?: string;
    };
  };
  priority?: boolean;
  isLCP?: boolean;
}

const { post, priority = false, isLCP = false } = Astro.props;
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);

const legacySlug = post.frontmatter?.legacySlug;
const issueTitle = post.frontmatter?.issueTitle;
const link = post.frontmatter?.numericUrl ?? toNumericUrl(post.url);
const title = parseTitle(link, legacySlug, issueTitle, lang);
const { image, description, date } = post.frontmatter;
const cardImage = image.startsWith('http') && !image.match(/\.(?:svg|gif)(?:\?.*)?$/i)
  ? `${image}?x-oss-process=image/resize,w_640/format,webp`
  : image;
const tags = post.frontmatter.tags ?? [];
---

<a
  href={link}
  data-astro-prefetch
  data-image={image}
  class='article-card rounded-lg shadow-md overflow-hidden w-full card-content preload-link'
  style='transition: all 200ms ease; will-change: transform;'
>
  <img
    src={cardImage}
    width='640'
    height='384'
    alt={title}
    loading={priority ? 'eager' : 'lazy'}
    decoding='async'
    fetchpriority={isLCP ? 'high' : 'auto'}
    class='block w-full aspect-[5/3] object-cover rounded-t-lg'
    style='transition: transform 200ms ease;'
  />
  <div class='w-full flex justify-between items-baseline leading-tight'>
    <div
      class='text-gray-800 dark:text-gray-200 font-semibold md:text-lg text-lg overflow-hidden text-ellipsis whitespace-nowrap flex-1 mr-4 min-w-0'
    >
      {title}
    </div>
    <time class='text-grey-darker text-gray-600 dark:text-gray-300 md:text-sm text-sm flex-shrink-0' datetime={date}>
      {date}
    </time>
  </div>
  {
    tags.length > 0 && (
      <div class='article-tags' aria-label='文章标签'>
        {tags.map((tag, index) => (
          <>
            {index > 0 && <span class='article-tag-separator' aria-hidden='true'>|</span>}
            <span>{tag}</span>
          </>
        ))}
      </div>
    )
  }
  <p class='text-gray-600 dark:text-gray-300 overflow-hidden pt-2 line-clamp-2 w-full md:text-sm text-base px-3 md:h-12 h-14'>
    {description}
  </p>
</a>

<style>
  .article-card {
    display: block;
    padding: 18px 20px;
  }

  @media (max-width: 640px) {
    .article-card {
      padding: 16px;
    }
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 10px;
    color: rgb(107 114 128);
    font-size: 13px;
    line-height: 1.4;
  }

  .article-tags span {
    white-space: nowrap;
  }

  .article-tag-separator {
    color: rgb(156 163 175);
  }

  :global([data-theme='dark']) .article-tags {
    color: rgb(209 213 219);
  }

  :global([data-theme='dark']) .article-tag-separator {
    color: rgb(107 114 128);
  }
</style>
