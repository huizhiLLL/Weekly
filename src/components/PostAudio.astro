---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class='post-audio' data-post-audio={src} data-pagefind-ignore>
  <div class='post-audio-controls'>
    <button type='button'>
      <!-- Lucide Play and LoaderCircle. See /licenses/lucide.txt. -->
      <svg class='button-icon' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
        <path class='play-icon' d='M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z' />
        <path class='loading-icon' d='M21 12a9 9 0 1 1-6.219-8.56' />
      </svg>
      <span>播放 {title}</span>
    </button>
    <audio aria-label={title} controls preload='none'></audio>
  </div>
  <small role='status'></small>
</div>

<script>
  for (const player of document.querySelectorAll<HTMLElement>('[data-post-audio]')) {
    const src = player.dataset.postAudio;
    const button = player.querySelector('button');
    const audio = player.querySelector('audio');
    const status = player.querySelector('small');
    if (!src || !button || !audio || !status) continue;

    button.addEventListener('click', async () => {
      if (button.hasAttribute('aria-disabled')) return;

      button.setAttribute('aria-disabled', 'true');
      status.classList.add('sr-only');
      status.textContent = '正在加载音频…';
      audio.src = src;

      try {
        await audio.play();
        const shouldFocusAudio = document.activeElement === button;
        player.dataset.audioReady = '';
        if (shouldFocusAudio) audio.focus();
        status.textContent = '';
      } catch {
        audio.removeAttribute('src');
        audio.load();
        status.textContent = '音频加载失败，可以再试一次。';
      } finally {
        button.removeAttribute('aria-disabled');
        status.classList.remove('sr-only');
      }
    });
  }
</script>

<style>
  .post-audio {
    margin-block: 0 var(--space-6);
  }

  .post-audio-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  .post-audio-controls > * {
    grid-area: 1 / 1;
  }

  button {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    max-width: 100%;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--theme-accent) 13%, var(--theme-bg));
    color: var(--theme-text);
    font-size: var(--font-size-small);
    font-weight: 400;
    text-align: start;
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  button:not([aria-disabled]):hover {
    background: color-mix(in srgb, var(--theme-accent) 22%, var(--theme-bg));
  }

  button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  button[aria-disabled='true'] {
    cursor: progress;
  }

  .button-icon {
    flex: none;
  }

  .play-icon {
    fill: currentColor;
  }

  .loading-icon,
  button[aria-disabled='true'] .play-icon {
    display: none;
  }

  button[aria-disabled='true'] .loading-icon {
    display: inline;
  }

  @media (prefers-reduced-motion: no-preference) {
    button[aria-disabled='true'] .loading-icon {
      transform-origin: center;
      animation: post-audio-spin 700ms linear infinite;
    }
  }

  @keyframes post-audio-spin {
    to {
      transform: rotate(1turn);
    }
  }

  audio {
    width: 100%;
    visibility: hidden;
    color-scheme: light dark;
  }

  [data-audio-ready] audio {
    visibility: visible;
  }

  [data-audio-ready] button {
    visibility: hidden;
  }

  small:not(:empty, .sr-only) {
    display: block;
    margin-block-start: var(--space-2);
    font-size: var(--font-size-small);
  }
</style>
