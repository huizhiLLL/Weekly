---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Header from '../components/Header/Header.astro';
import { SITE } from '@/config';
import { sortPosts } from '@/util';

const posts = Object.values(import.meta.glob('./posts/*.md', { eager: true })) as any[];
const allPosts = sortPosts(posts);
---

<BaseLayout title={SITE.title} description={SITE.description} pageURL={SITE.homePage}>
  <style slot='head'>
    .card-content:hover {
      transform: translateY(-4px);
      box-shadow:
        0 8px 16px -2px rgb(0 0 0 / 0.12),
        0 4px 8px -2px rgb(0 0 0 / 0.08);
    }

    .card-content:active {
      transform: translateY(-2px);
    }
  </style>

  <Header />
  <div class='home-shell mt-9 mb-12'>
    <div class='home-list'>
      {allPosts.map((post) => <Card post={post} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .home-shell {
    width: min(calc(100% - 32px), 980px);
    margin-inline: auto;
    box-sizing: border-box;
  }

  .home-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  @media (min-width: 640px) {
    .home-shell {
      width: min(70vw, 980px);
    }
  }
</style>
