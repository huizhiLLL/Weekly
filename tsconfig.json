{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "jsx": "preserve",
    "paths": {
      "@layouts/*": ["./src/layouts/*"],
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  }
}
